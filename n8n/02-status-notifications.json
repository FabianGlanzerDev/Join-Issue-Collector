    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const statusNames = {\n  triage: 'Triage',\n\n  todo: 'To do',\n  'to-do': 'To do',\n\n  inprogress: 'In progress',\n  'in-progress': 'In progress',\n  in_progress: 'In progress',\n\n  awaitfeedback: 'Await feedback',\n  'await-feedback': 'Await feedback',\n  await_feedback: 'Await feedback',\n\n  done: 'Done',\n};\n\nconst oldStatus =\n  statusNames[$json.lastNotifiedColumn] ?? $json.lastNotifiedColumn;\n\nconst newStatus =\n  statusNames[$json.column] ?? $json.column;\n\nreturn {\n  json: {\n    ...$json,\n\n    mailSubject:\n      `Join: Statusänderung bei „${$json.title}“`,\n\n    mailText:\n`Hallo ${$json.creatorName || 'Hallo'},\n\nder Status deines Tickets wurde geändert.\n\nTitel: ${$json.title}\nVorheriger Status: ${oldStatus}\nNeuer Status: ${newStatus}\nTicket-ID: ${$json.taskId}\n\nDu wirst bei weiteren Statusänderungen automatisch informiert.\n\nDies ist eine automatisch generierte Benachrichtigung.`\n  }\n};"
      },
