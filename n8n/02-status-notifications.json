    {
      "parameters": {
        "jsCode": "const tasks = $input.first().json;\n\nreturn Object.entries(tasks)\n .filter(([id, task]) => {\n  return Boolean(task?.creatorEmail);\n})\n  .map(([taskId, task]) => ({\n    json: {\n      taskId,\n      ...task,\n      lastNotifiedColumn: task.lastNotifiedColumn ?? null,\n      needsBaseline: !task.lastNotifiedColumn,\n      statusChanged:\n        Boolean(task.lastNotifiedColumn) &&\n        task.column !== task.lastNotifiedColumn,\n    },\n  }));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ],
